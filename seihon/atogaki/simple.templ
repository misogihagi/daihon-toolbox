package atogaki

templ Simple(data AtogakiData) {
	{{ data = withDefaults(data, DefaultSimple()) }}
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.PageTitle }</title>
			<style>
				:root {
					--paper: #f6f2ea;
					--ink: #1d1c1a;
					--muted: #68645d;
					--accent: #8f3a2e;
					--fold: rgba(29, 28, 26, 0.14);
					--border-soft: rgba(29, 28, 26, 0.15);
				}
				
				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}
				
				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background: linear-gradient(180deg, #dcd5c7 0%, #c4bbb0 100%);
					padding: 32px 16px;
					font-family: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif JP", serif;
					color: var(--ink);
				}
				
				.spread {
					position: relative;
					width: min(880px, 96vw);
					min-height: 560px;
					background: var(--paper);
					border-radius: 4px;
					box-shadow:
						0 20px 45px rgba(29, 28, 26, 0.25),
						0 2px 6px rgba(29, 28, 26, 0.12);
					display: grid;
					grid-template-columns: 1fr 1fr;
					overflow: hidden;
				}
				
				/* 中央の綴じ目（ノド） */
				.spread::before {
					content: "";
					position: absolute;
					top: 0;
					bottom: 0;
					left: 50%;
					transform: translateX(-50%);
					width: 28px;
					background: linear-gradient(
						90deg,
						transparent 0%,
						rgba(29, 28, 26, 0.05) 35%,
						rgba(29, 28, 26, 0.16) 50%,
						rgba(29, 28, 26, 0.05) 65%,
						transparent 100%
					);
					pointer-events: none;
					z-index: 2;
				}
				
				.page {
					writing-mode: vertical-rl;
					text-orientation: mixed;
					padding: 32px 34px;
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					position: relative;
					min-height: 560px;
				}
				
				.page--right {
					border-left: 1px solid var(--border-soft);
				}
				
				.running-head {
					font-size: 10.5px;
					letter-spacing: 0.24em;
					color: var(--muted);
					height: 100%;
					display: flex;
					align-items: flex-start;
					padding-left: 14px;
				}
				
				/* 右ページ：作者による執筆の感想 */
				.author-essay {
					flex: 1;
					font-size: clamp(13.5px, 1.6vw, 15px);
					line-height: 1.88;
					letter-spacing: 0.05em;
					color: #242320;
					overflow: hidden;
				}
				
				.section-label {
					font-size: 15px;
					font-weight: 600;
					letter-spacing: 0.26em;
					margin-left: 20px;
					padding-top: 8px;
					color: var(--ink);
				}
				
				.author-essay p {
					text-indent: 1em;
					margin-left: 0.55em;
				}
				
				.author-essay p + p {
					margin-left: 0.65em;
				}
				
				.author-sign {
					margin-right: 14px;
					align-self: flex-end;
					font-size: 13.5px;
					letter-spacing: 0.26em;
					color: var(--ink);
				}
				
				/* 左ページ：編集・デザイナーからのコメント欄 */
				.staff-notes {
					flex: 1;
					display: flex;
					flex-direction: column;
					justify-content: center;
					gap: 22px;
					padding: 6px 4px;
				}
				
				.notes-header {
					font-size: 12px;
					letter-spacing: 0.28em;
					color: var(--accent);
					border-left: 1px solid var(--border-soft);
					padding-left: 10px;
					align-self: flex-start;
				}
				
				.comment-card {
					border-right: 1.5px solid var(--border-soft);
					padding-right: 12px;
					font-size: clamp(12.5px, 1.45vw, 13.8px);
					line-height: 1.82;
					letter-spacing: 0.04em;
					color: #2c2b28;
				}
				
				.comment-role {
					display: block;
					font-size: 11px;
					letter-spacing: 0.16em;
					color: var(--muted);
					margin-left: 6px;
				}
				
				.comment-name {
					font-weight: 600;
					color: var(--ink);
					letter-spacing: 0.18em;
				}
				
				.comment-card p {
					text-indent: 1em;
					margin-left: 0.45em;
				}
				
				.folio {
					font-size: 11px;
					letter-spacing: 0.16em;
					color: var(--muted);
					align-self: flex-end;
					padding-right: 12px;
				}
				
				@media (max-width: 760px) {
					.spread {
						grid-template-columns: 1fr;
						min-height: auto;
					}
				
					.spread::before {
						display: none;
					}
				
					.page {
						min-height: 460px;
						padding: 26px 22px;
					}
				
					.page--right {
						border-left: none;
						border-bottom: 1px solid var(--fold);
					}
				}
			</style>
		</head>
		<body>
			<main class="spread" aria-label={ data.SpreadLabel }>
				<!-- 右ページ：作者による作品を書いた感想 -->
				<section class="page page--right" aria-label={ data.Essay.Label }>
					<header class="running-head">{ data.Essay.RunningHead }</header>
					<article class="author-essay">
						<h1 class="section-label">{ data.Essay.Heading }</h1>
						for _, paragraph := range data.Essay.Paragraphs {
							<p>{ paragraph }</p>
						}
						<div class="author-sign">{ data.Essay.Author }</div>
					</article>
					<footer class="folio">{ data.Essay.Folio }</footer>
				</section>
				<!-- 左ページ：担当編集・装丁デザイナーのコメント -->
				<section class="page page--left" aria-label={ data.Notes.Label }>
					<header class="running-head">{ data.Title }</header>
					<aside class="staff-notes" aria-label={ data.Notes.CommentLabel }>
						<div class="notes-header">{ data.Notes.Heading }</div>
						for _, comment := range data.Notes.Comments {
							<div class="comment-card">
								<span class="comment-role">{ comment.Role }／<span class="comment-name">{ comment.Name }</span></span>
								<p>{ comment.Text }</p>
							</div>
						}
					</aside>
					<footer class="folio">{ data.Notes.Folio }</footer>
				</section>
			</main>
		</body>
	</html>
}

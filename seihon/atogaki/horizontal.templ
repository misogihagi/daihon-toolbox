package atogaki

templ Horizontal(data AtogakiData) {
	{{ data = withDefaults(data, DefaultHorizontal()) }}
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.PageTitle }</title>
			<style>
				:root {
					--paper: #f6f2ea;
					--ink: #1d1c1a;
					--muted: #68645d;
					--accent: #8f3a2e;
					--fold: rgba(29, 28, 26, 0.14);
					--border-soft: rgba(29, 28, 26, 0.15);
				}
				
				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}
				
				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background: linear-gradient(180deg, #dcd5c7 0%, #c4bbb0 100%);
					padding: 32px 16px;
					font-family: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif JP", serif;
					color: var(--ink);
				}
				
				/* 横書き見開き（左ページ→右ページへ読む構成） */
				.spread {
					position: relative;
					width: min(900px, 96vw);
					min-height: 540px;
					background: var(--paper);
					border-radius: 4px;
					box-shadow:
						0 20px 45px rgba(29, 28, 26, 0.25),
						0 2px 6px rgba(29, 28, 26, 0.12);
					display: grid;
					grid-template-columns: 1fr 1fr;
					overflow: hidden;
				}
				
				/* 中央の綴じ目（ノド） */
				.spread::before {
					content: "";
					position: absolute;
					top: 0;
					bottom: 0;
					left: 50%;
					transform: translateX(-50%);
					width: 28px;
					background: linear-gradient(
						90deg,
						transparent 0%,
						rgba(29, 28, 26, 0.05) 35%,
						rgba(29, 28, 26, 0.16) 50%,
						rgba(29, 28, 26, 0.05) 65%,
						transparent 100%
					);
					pointer-events: none;
					z-index: 2;
				}
				
				.page {
					padding: 30px 36px 26px;
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					position: relative;
					min-height: 540px;
				}
				
				.page--left {
					border-right: 1px solid var(--border-soft);
				}
				
				/* 柱（ランニングヘッド） */
				.running-head {
					display: flex;
					justify-content: space-between;
					font-size: 10.5px;
					letter-spacing: 0.2em;
					color: var(--muted);
					padding-bottom: 12px;
					border-bottom: 1px solid rgba(29, 28, 26, 0.08);
					margin-bottom: 18px;
				}
				
				/* 左ページ：作者による執筆の感想 */
				.author-essay {
					flex: 1;
					font-size: clamp(13.5px, 1.55vw, 15px);
					line-height: 1.85;
					letter-spacing: 0.03em;
					color: #242320;
				}
				
				.section-label {
					font-size: 16px;
					font-weight: 600;
					letter-spacing: 0.2em;
					margin-bottom: 14px;
					color: var(--ink);
				}
				
				.author-essay p {
					text-indent: 1em;
					margin-bottom: 12px;
				}
				
				.author-sign {
					margin-top: 18px;
					text-align: right;
					font-size: 13.5px;
					letter-spacing: 0.22em;
					color: var(--ink);
				}
				
				/* 右ページ：編集・デザイナーからのコメント欄 */
				.staff-notes {
					flex: 1;
					display: flex;
					flex-direction: column;
					justify-content: center;
					gap: 20px;
				}
				
				.notes-header {
					font-size: 12px;
					font-weight: 600;
					letter-spacing: 0.22em;
					color: var(--accent);
					padding-bottom: 6px;
					border-bottom: 1px solid var(--border-soft);
				}
				
				.comment-card {
					border-left: 2px solid var(--border-soft);
					padding-left: 14px;
					font-size: clamp(12.5px, 1.45vw, 13.8px);
					line-height: 1.78;
					letter-spacing: 0.02em;
					color: #2c2b28;
				}
				
				.comment-role {
					display: block;
					font-size: 11px;
					letter-spacing: 0.12em;
					color: var(--muted);
					margin-bottom: 5px;
				}
				
				.comment-name {
					font-weight: 600;
					color: var(--ink);
					letter-spacing: 0.14em;
				}
				
				.comment-card p {
					text-indent: 1em;
				}
				
				/* ノンブル（ページ番号） */
				.folio {
					font-size: 11px;
					letter-spacing: 0.16em;
					color: var(--muted);
					text-align: center;
					padding-top: 14px;
				}
				
				@media (max-width: 760px) {
					.spread {
						grid-template-columns: 1fr;
						min-height: auto;
					}
				
					.spread::before {
						display: none;
					}
				
					.page {
						min-height: auto;
						padding: 26px 22px;
					}
				
					.page--left {
						border-right: none;
						border-bottom: 1px solid var(--fold);
					}
				}
			</style>
		</head>
		<body>
			<main class="spread" aria-label={ data.SpreadLabel }>
				<!-- 左ページ：作者による作品を書いた感想 -->
				<section class="page page--left" aria-label={ data.Essay.Label }>
					<div>
						<header class="running-head">
							<span>{ data.Essay.RunningHead }</span>
							<span>{ data.Essay.Author }</span>
						</header>
						<article class="author-essay">
							<h1 class="section-label">{ data.Essay.Heading }</h1>
							for _, paragraph := range data.Essay.Paragraphs {
								<p>{ paragraph }</p>
							}
							<div class="author-sign">{ data.Essay.Author }</div>
						</article>
					</div>
					<footer class="folio">{ data.Essay.Folio }</footer>
				</section>
				<!-- 右ページ：担当編集・装丁デザイナーのコメント -->
				<section class="page page--right" aria-label={ data.Notes.Label }>
					<div>
						<header class="running-head">
							<span>{ data.Title }</span>
							<span>{ data.Notes.RunningHead }</span>
						</header>
						<aside class="staff-notes" aria-label={ data.Notes.CommentLabel }>
							<div class="notes-header">{ data.Notes.Heading }</div>
							for _, comment := range data.Notes.Comments {
								<div class="comment-card">
									<span class="comment-role">{ comment.Role }／<span class="comment-name">{ comment.Name }</span></span>
									<p>{ comment.Text }</p>
								</div>
							}
						</aside>
					</div>
					<footer class="folio">{ data.Notes.Folio }</footer>
				</section>
			</main>
		</body>
	</html>
}

package honbun

templ SimpleContentStyles() {
	<style>
		:root {
			--paper: #f6f2ea;
			--ink: #1d1c1a;
			--muted: #68645d;
			--fold: rgba(29, 28, 26, 0.14);
			--border-soft: rgba(29, 28, 26, 0.12);
		}

		/* 本文部分だけを埋め込むとき用のリセット（各クラス指定より前に置く） */
		.page,
		.page * {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		/* 本文ページ */
		.page {
			writing-mode: vertical-rl;
			text-orientation: mixed;
			padding: 34px 36px;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			position: relative;
			min-height: 540px;
		}

		.page--right {
			border-left: 1px solid var(--border-soft);
		}

		/* 柱（ランニングヘッド：天側の見出し） */
		.running-head {
			font-size: 10.5px;
			letter-spacing: 0.24em;
			color: var(--muted);
			height: 100%;
			display: flex;
			align-items: flex-start;
			padding-left: 14px;
		}

		/* 本文エリア */
		.body-text {
			flex: 1;
			font-size: clamp(14.5px, 1.85vw, 17px);
			line-height: 1.95;
			letter-spacing: 0.06em;
			overflow: hidden;
		}

		.chapter-title {
			font-size: clamp(17px, 2.2vw, 20px);
			font-weight: 600;
			letter-spacing: 0.22em;
			margin-left: 28px;
			padding-top: 24px;
			color: var(--ink);
		}

		.body-text p {
			text-indent: 1em; /* 段落冒頭の1字下げ */
			margin-left: 0.55em;
		}

		.body-text p + p {
			margin-left: 0.7em;
		}

		/* 場面転換の空き行（アキ） */
		.scene-break {
			writing-mode: horizontal-tb;
			text-align: center;
			letter-spacing: 0.6em;
			color: var(--muted);
			font-size: 13px;
			padding: 12px 0;
			margin-left: 18px;
		}

		/* ノンブル（ページ番号） */
		.folio {
			font-size: 11px;
			letter-spacing: 0.16em;
			color: var(--muted);
			align-self: flex-end;
			padding-right: 12px;
		}

		/* 画面幅が狭いときは1ページずつ縦並びにする */
		@media (max-width: 720px) {
			.page {
				min-height: 460px;
				padding: 26px 22px;
			}

			.page--right {
				border-left: none;
				border-bottom: 1px solid var(--fold);
			}
		}
	</style>
}

// SimplePages は本文の2ページ分だけを描画する。
// A5 レイアウトの <main> 内などに埋め込んで使う。
templ SimplePages(data BodyData) {
	{{ data = withDefaults(data, DefaultSimple()) }}
	<!-- 右ページ（縦書きの1ページ目） -->
	<section class="page page--right" aria-label={ data.RightPage.Label }>
		<header class="running-head">{ data.Title }</header>
		<article class="body-text">
			if data.RightPage.ChapterTitle != "" {
				<h1 class="chapter-title">{ data.RightPage.ChapterTitle }</h1>
			}
			for _, paragraph := range data.RightPage.Paragraphs {
				<p>{ paragraph }</p>
			}
		</article>
		<footer class="folio">{ data.RightPage.Folio }</footer>
	</section>
	<!-- 左ページ（縦書きの2ページ目） -->
	<section class="page page--left" aria-label={ data.LeftPage.Label }>
		<header class="running-head">{ data.Author }</header>
		<article class="body-text">
			for _, paragraph := range data.LeftPage.Paragraphs {
				<p>{ paragraph }</p>
			}
			if data.LeftPage.SceneBreak != "" {
				<div class="scene-break" aria-hidden="true">{ data.LeftPage.SceneBreak }</div>
			}
			for _, paragraph := range data.LeftPage.TailParagraphs {
				<p>{ paragraph }</p>
			}
		</article>
		<footer class="folio">{ data.LeftPage.Folio }</footer>
	</section>
}

templ Simple(data BodyData) {
	{{ data = withDefaults(data, DefaultSimple()) }}
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>純文学本文 — { data.Title }</title>
			@SimpleContentStyles()
			<style>
				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background: linear-gradient(180deg, #dcd5c7 0%, #c4bbb0 100%);
					padding: 32px 16px;
					font-family: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif JP", serif;
					color: var(--ink);
				}

				/* 見開き（右ページ→左ページへ読む縦書きの紙面） */
				.spread {
					position: relative;
					width: min(860px, 96vw);
					min-height: 540px;
					background: var(--paper);
					border-radius: 4px;
					box-shadow:
						0 20px 45px rgba(29, 28, 26, 0.25),
						0 2px 6px rgba(29, 28, 26, 0.12);
					display: grid;
					grid-template-columns: 1fr 1fr;
					overflow: hidden;
				}

				/* ノド（中央の綴じ目・影） */
				.spread::before {
					content: "";
					position: absolute;
					top: 0;
					bottom: 0;
					left: 50%;
					transform: translateX(-50%);
					width: 28px;
					background: linear-gradient(
						90deg,
						transparent 0%,
						rgba(29, 28, 26, 0.05) 35%,
						rgba(29, 28, 26, 0.16) 50%,
						rgba(29, 28, 26, 0.05) 65%,
						transparent 100%
					);
					pointer-events: none;
					z-index: 2;
				}

				/* 画面幅が狭いときは見開きを1ページずつ縦並びにする */
				@media (max-width: 720px) {
					.spread {
						grid-template-columns: 1fr;
						min-height: auto;
					}

					.spread::before {
						display: none;
					}
				}
			</style>
		</head>
		<body>
			<main class="spread" aria-label={ data.SpreadLabel }>
				@SimplePages(data)
			</main>
		</body>
	</html>
}

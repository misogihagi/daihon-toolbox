package honbun

templ SimpleContentStyles() {
	<style>
		:root {
			--paper: #f6f2ea;
			--ink: #1d1c1a;
			--muted: #68645d;
			--fold: rgba(29, 28, 26, 0.14);
			--border-soft: rgba(29, 28, 26, 0.12);
			--b6-w: 128mm;
			--b6-h: 182mm;
			--margin-top: 21mm;
			--margin-bottom: 16mm;
			--margin-fore-edge: 13mm; /* 小口 */
			--margin-spine: 23mm;     /* ノド */
			--spine-shadow: 10mm;     /* ノド中心からの影の幅 */
		}

		/* 本文部分だけを埋め込むとき用のリセット（各クラス指定より前に置く） */
		.page,
		.page *,
		.page *::before,
		.page *::after {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		/* 本文ページ（B6・9ptの文庫／純文学サイズ・縦書き） */
		.page {
			display: flex;
			flex-direction: column;
			gap: 6mm;
			background: var(--paper);
		}

		/* 柱（ランニングヘッド＋ノンブル：横書き・天側上部に配置） */
		.running-head {
			width: 100%;
			writing-mode: horizontal-tb;
			font-size: 7pt;
			line-height: 1.4;
			letter-spacing: 0.16em;
			color: var(--muted);
			display: flex;
			align-items: center;
			justify-content: space-between;
			white-space: nowrap;
			flex-shrink: 0;
		}

		/* 柱内のノンブル（ページ番号） */
		.folio {
			font-size: 7.5pt;
			letter-spacing: 0.12em;
			font-variant-numeric: lining-nums;
		}

		/* 本文エリア（B6・9ptの文庫／純文学サイズ・縦書き） */
		.body-text {
			flex: 1;
			min-height: 0;
			writing-mode: vertical-rl;
			text-orientation: mixed;
			font-size: 9pt;
			line-height: 1.7;
			overflow: hidden;
		}

		.chapter-title {
			font-size: 11pt;
			font-weight: 600;
			letter-spacing: 0.18em;
			margin-left: 8mm;
			padding-top: 8mm;
			color: var(--ink);
		}

		/* 場面転換の空き行（アキ） */
		.scene-break {
			writing-mode: horizontal-tb;
			text-align: center;
			letter-spacing: 0.5em;
			color: var(--muted);
			font-size: 8.5pt;
			padding: 4mm 0;
			margin-left: 5mm;
		}
	</style>
}

// SimplePages は本文の2ページ分だけを描画する。
// A5 / B6 レイアウトの <main> 内などに埋め込んで使う。
templ SimplePages(data BodyData) {
	{{ data = withDefaults(data, DefaultSimple()) }}
	<!-- 右ページ（縦書きの1ページ目：13ページ → ノド側に章名、小口側にノンブル） -->
	<section class="page page--right" aria-label={ data.RightPage.Label }>
		<header class="running-head">
			<span class="running-title">{ data.RightPage.ChapterTitle }</span>
			<span class="folio">{ data.RightPage.Folio }</span>
		</header>
		<article class="body-text">
			if data.RightPage.ChapterTitle != "" {
				<h1 class="chapter-title">{ data.RightPage.ChapterTitle }</h1>
			}
			for _, paragraph := range data.RightPage.Paragraphs {
				<p>{ paragraph }</p>
			}
		</article>
	</section>
	<!-- 左ページ（縦書きの2ページ目：14ページ → 小口側にノンブル、ノド側に作品タイトル） -->
	<section class="page page--left" aria-label={ data.LeftPage.Label }>
		<header class="running-head">
			<span class="folio">{ data.LeftPage.Folio }</span>
			<span class="running-title">{ data.Title }</span>
		</header>
		<article class="body-text">
			for _, paragraph := range data.LeftPage.Paragraphs {
				<p>{ paragraph }</p>
			}
			if data.LeftPage.SceneBreak != "" {
				<div class="scene-break" aria-hidden="true">{ data.LeftPage.SceneBreak }</div>
			}
			for _, paragraph := range data.LeftPage.TailParagraphs {
				<p>{ paragraph }</p>
			}
		</article>
	</section>
}

templ Simple(data BodyData) {
	{{ data = withDefaults(data, DefaultSimple()) }}
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>純文学本文 — { data.Title }（B6・9pt）</title>
			@SimpleContentStyles()
			<style>
				*, *::before, *::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background: linear-gradient(180deg, #dcd5c7 0%, #c4bbb0 100%);
					padding: 24px 16px;
					font-family: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif JP", serif;
					color: var(--ink);
				}

				/* 見開き（B6片面 128mm × 182mm の2面＝256mm × 182mm） */
				.spread {
					width: calc(var(--b6-w) * 2);
					max-width: 100%;
					height: var(--b6-h);
					background: var(--paper);
					border-radius: 2px;
					box-shadow:
						0 20px 45px rgba(29, 28, 26, 0.25),
						0 2px 6px rgba(29, 28, 26, 0.12);
					display: grid;
					grid-template-columns: var(--b6-w) var(--b6-w);
					overflow: hidden;
				}

				/* 右から左（13ページ → 14ページ）の順で配置 */
				.page {
					width: var(--b6-w);
					height: var(--b6-h);
				}

				.page--right {
					grid-column: 2;
					grid-row: 1;
					order: 1;
					padding: var(--margin-top) var(--margin-fore-edge) var(--margin-bottom) var(--margin-spine);
					border-left: 1px solid var(--border-soft);
					box-shadow: inset var(--spine-shadow) 0 calc(var(--spine-shadow) * 0.8) calc(var(--spine-shadow) * -0.35) rgba(29, 28, 26, 0.18);
				}

				.page--left {
					grid-column: 1;
					grid-row: 1;
					order: 2;
					padding: var(--margin-top) var(--margin-spine) var(--margin-bottom) var(--margin-fore-edge);
					box-shadow: inset calc(var(--spine-shadow) * -1) 0 calc(var(--spine-shadow) * 0.8) calc(var(--spine-shadow) * -0.35) rgba(29, 28, 26, 0.18);
				}

				/* 画面幅が狭いときは1ページずつ縦並びにする（13ページ→14ページの順） */
				@media (max-width: 720px) {
					.spread {
						width: var(--b6-w);
						max-width: 100%;
						height: auto;
						grid-template-columns: 1fr;
					}

					.page {
						width: 100%;
						height: var(--b6-h);
					}

					.page--right {
						grid-column: auto;
						grid-row: auto;
						order: 1;
						padding: var(--margin-top) var(--margin-fore-edge) var(--margin-bottom) var(--margin-spine);
						border-left: none;
						border-bottom: 1px solid var(--fold);
						box-shadow: none;
					}

					.page--left {
						grid-column: auto;
						grid-row: auto;
						order: 2;
						padding: var(--margin-top) var(--margin-fore-edge) var(--margin-bottom) var(--margin-spine);
						box-shadow: none;
					}
				}

				@page {
					size: 128mm 182mm;
					margin: 0;
				}

				@media print {
					* {
						-webkit-print-color-adjust: none;
						print-color-adjust: none;
					}

					html, body {
						width: var(--b6-w);
						margin: 0;
						padding: 0;
						background: var(--paper);
						display: block;
					}

					.spread {
						display: flex;
						flex-direction: column;
						width: var(--b6-w);
						max-width: none;
						height: auto;
						background: transparent;
						box-shadow: none;
						border-radius: 0;
						overflow: visible;
					}

					.page {
						width: var(--b6-w);
						height: var(--b6-h);
						box-shadow: none;
						border: none;
						break-inside: avoid;
						page-break-inside: avoid;
					}

					/* 印刷時は 13ページ（.page--right）→ 14ページ（.page--left）の順で各1ページに出力 */
					.page--right {
						order: 1;
						padding: var(--margin-top) var(--margin-fore-edge) var(--margin-bottom) var(--margin-spine);
						break-after: page;
						page-break-after: always;
					}

					.page--left {
						order: 2;
						padding: var(--margin-top) var(--margin-spine) var(--margin-bottom) var(--margin-fore-edge);
						break-after: auto;
						page-break-after: auto;
					}
				}
			</style>
		</head>
		<body>
			<main class="spread" aria-label={ data.SpreadLabel }>
				@SimplePages(data)
			</main>
		</body>
	</html>
}

package hyoushi

templ LightNovel() {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>ライトノベル表紙風 — 放課後、時計塔の鍵をなくした僕らは世界を巻き戻す</title>
			<style>
				:root {
					--bg-dark: #0e1224;
					--sky-top: #1d2b64;
					--sky-mid: #4a3f8c;
					--sky-glow: #f8a5c2;
					--gold: #ffd166;
					--cyan: #48cae4;
					--pink: #ff4d8d;
					--white: #ffffff;
					--ink: #12131a;
				}

				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background:
						radial-gradient(circle at 20% 15%, rgba(72, 202, 228, 0.16), transparent 40%),
						radial-gradient(circle at 85% 80%, rgba(255, 77, 141, 0.18), transparent 45%),
						#090b14;
					padding: 32px 16px;
					font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
					color: var(--white);
				}

				/* ラノベ判型（B6〜四六判寄りの縦長比率） */
				.ln-cover {
					position: relative;
					width: min(410px, 92vw);
					aspect-ratio: 1 / 1.46;
					background: linear-gradient(165deg, var(--sky-top) 0%, var(--sky-mid) 52%, #241942 100%);
					border-radius: 4px 12px 12px 4px;
					box-shadow:
						inset -10px 0 18px rgba(0, 0, 0, 0.45),
						8px 0 0 #d8dce6,
						20px 26px 55px rgba(0, 0, 0, 0.7);
					padding: 20px 20px 18px;
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					overflow: hidden;
				}

				/* 背景の光とスピード感 */
				.ln-cover::before {
					content: "";
					position: absolute;
					width: 280px;
					height: 280px;
					right: -60px;
					top: 70px;
					border-radius: 50%;
					background: radial-gradient(circle, rgba(255, 209, 102, 0.45), rgba(255, 77, 141, 0.15) 55%, transparent 72%);
					filter: blur(6px);
					pointer-events: none;
				}

				.diagonal-slash {
					position: absolute;
					left: -25%;
					bottom: 24%;
					width: 150%;
					height: 54px;
					background: linear-gradient(90deg, transparent, rgba(72, 202, 228, 0.25), rgba(255, 77, 141, 0.32), transparent);
					transform: rotate(-11deg);
					pointer-events: none;
				}

				/* 上部：レーベル・巻数 */
				.top-header {
					position: relative;
					z-index: 2;
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 8px;
				}

				.label-tag {
					background: linear-gradient(90deg, var(--pink), #ff7eb3);
					color: var(--white);
					font-size: 11px;
					font-weight: 900;
					letter-spacing: 0.14em;
					padding: 5px 12px;
					border-radius: 3px;
					box-shadow: 0 2px 10px rgba(255, 77, 141, 0.45);
				}

				.vol-badge {
					background: rgba(14, 18, 36, 0.75);
					border: 1px solid var(--gold);
					color: var(--gold);
					font-size: 12px;
					font-weight: 800;
					letter-spacing: 0.1em;
					padding: 4px 10px;
					border-radius: 3px;
				}

				/* イラスト枠（ここに背景画やキャラ絵・SVGを差し替え可能） */
				.art-frame {
					position: relative;
					z-index: 1;
					margin: 10px 0;
					height: 176px;
					border-radius: 10px;
					border: 1.5px solid rgba(255, 255, 255, 0.28);
					background:
						radial-gradient(circle at 68% 36%, rgba(255, 241, 188, 0.9), rgba(255, 159, 178, 0.35) 38%, transparent 65%),
						linear-gradient(180deg, rgba(20, 28, 68, 0.3), rgba(14, 18, 36, 0.85));
					display: flex;
					flex-direction: column;
					justify-content: flex-end;
					padding: 12px 14px;
					overflow: hidden;
				}

				/* 抽象的な時計塔＆星屑シルエット（画像なしでも雰囲気を出す装飾） */
				.clock-tower {
					position: absolute;
					right: 24px;
					bottom: -8px;
					width: 54px;
					height: 132px;
					background: rgba(12, 15, 30, 0.78);
					border-top: 3px solid var(--gold);
				}

				.clock-tower::before {
					content: "";
					position: absolute;
					top: 14px;
					left: 50%;
					transform: translateX(-50%);
					width: 24px;
					height: 24px;
					border-radius: 50%;
					border: 2px solid var(--gold);
					background: rgba(255, 209, 102, 0.2);
				}

				.art-caption {
					position: relative;
					z-index: 1;
					align-self: flex-start;
					background: rgba(14, 18, 36, 0.72);
					border-left: 3px solid var(--cyan);
					padding: 4px 9px;
					font-size: 10px;
					letter-spacing: 0.08em;
					color: #d8f3ff;
				}

				/* 煽り文句＋メインタイトル */
				.title-block {
					position: relative;
					z-index: 3;
					margin-top: 2px;
				}

				.catch-top {
					font-size: 12px;
					font-weight: 800;
					color: var(--gold);
					letter-spacing: 0.06em;
					text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
					margin-bottom: 4px;
				}

				.ln-title {
					font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
					font-size: clamp(20px, 4.9vw, 27px);
					font-weight: 700;
					line-height: 1.32;
					letter-spacing: 0.04em;
					color: var(--white);
					text-shadow:
						0 2px 0 var(--ink),
						0 0 18px rgba(72, 202, 228, 0.45);
				}

				.ln-title .accent-word {
					color: #ffe082;
				}

				/* ラノベ特有の帯（推薦文・重版・メディア化風） */
				.ln-obi {
					position: relative;
					z-index: 3;
					margin: 12px -20px 0;
					padding: 10px 18px;
					background: linear-gradient(90deg, #fff3b0, #ffd166);
					color: var(--ink);
					border-top: 2px solid var(--white);
					border-bottom: 2px solid var(--pink);
					box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
				}

				.obi-badge {
					display: inline-block;
					background: var(--pink);
					color: var(--white);
					font-size: 10px;
					font-weight: 900;
					padding: 2px 7px;
					border-radius: 2px;
					margin-bottom: 4px;
					letter-spacing: 0.08em;
				}

				.obi-text {
					font-size: 12px;
					font-weight: 800;
					line-height: 1.5;
				}

				/* 下部：著者・イラストレーター */
				.credits {
					position: relative;
					z-index: 2;
					padding-top: 10px;
					display: flex;
					justify-content: space-between;
					align-items: flex-end;
					font-size: 12px;
					gap: 8px;
				}

				.author-ln {
					font-size: 15px;
					font-weight: 900;
					letter-spacing: 0.1em;
				}

				.illustrator {
					font-size: 11px;
					color: #d0d6f5;
					text-align: right;
				}
			</style>
		</head>
		<body>
			<article class="ln-cover" aria-label="ライトノベル風の本の表紙デザイン">
				<div class="diagonal-slash" aria-hidden="true"></div>

				<header class="top-header">
					<span class="label-tag">STARLIGHT BUNKO</span>
					<span class="vol-badge">第1巻</span>
				</header>

				<div class="art-frame">
					<div class="clock-tower" aria-hidden="true"></div>
					<span class="art-caption">ILLUSTRATION AREA（画像・SVG差し替え可）</span>
				</div>

				<section class="title-block">
					<p class="catch-top">「あと五分だけ、君とやり直したい」——停まった時間が動き出す青春ファンタジー！</p>
					<h1 class="ln-title">
						放課後、時計塔の鍵をなくした僕らは<br/>
						<span class="accent-word">世界を巻き戻す</span>
					</h1>
				</section>

				<div class="ln-obi">
					<span class="obi-badge">発売即重版決定！</span>
					<p class="obi-text">
						無口な図書委員と落ちこぼれ鍵師が挑む、七度目の夏休み。<br/>
						ラスト三ページの伏線に、きっと息をのむ。
					</p>
				</div>

				<footer class="credits">
					<span class="author-ln">著／神楽 悠真</span>
					<span class="illustrator">イラスト／白銀 こなつ</span>
				</footer>
			</article>
		</body>
	</html>
}

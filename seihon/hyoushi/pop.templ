package hyoushi

templ Pop(data CoverData) {
	{{ data = withDefaults(data, DefaultPop()) }}
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>ポップ表紙風 — { joinLines(data.Title) }</title>
			<style>
				:root {
					--bg-pop: #fff8e7;
					--card-yellow: #ffd166;
					--coral: #ff6b6b;
					--mint: #2ec4b6;
					--ink: #23202a;
					--white: #ffffff;
				}

				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				body {
					min-height: 100vh;
					display: grid;
					place-items: center;
					background:
						radial-gradient(#ffd16655 2px, transparent 2px),
						#eef7f6;
					background-size: 20px 20px;
					padding: 32px 16px;
					font-family: "Hiragino Maru Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
					color: var(--ink);
				}

				.pop-book {
					position: relative;
					width: min(420px, 92vw);
					aspect-ratio: 1 / 1.44;
					background: var(--bg-pop);
					border: 3px solid var(--ink);
					border-radius: 8px 20px 20px 8px;
					box-shadow:
						8px 8px 0 var(--ink),
						14px 14px 0 var(--mint);
					padding: 26px 26px 24px;
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					overflow: hidden;
				}

				/* 角のポップな装飾 */
				.corner-star {
					position: absolute;
					top: -18px;
					right: -18px;
					width: 96px;
					height: 96px;
					background: var(--mint);
					border: 3px solid var(--ink);
					border-radius: 50%;
					display: grid;
					place-items: center;
					font-size: 28px;
					transform: rotate(12deg);
				}

				.top-bar {
					position: relative;
					z-index: 1;
					display: flex;
					align-items: center;
					gap: 8px;
					flex-wrap: wrap;
				}

				.pill {
					display: inline-block;
					padding: 4px 12px;
					font-size: 11px;
					font-weight: 800;
					letter-spacing: 0.08em;
					border: 2px solid var(--ink);
					border-radius: 999px;
					background: var(--card-yellow);
				}

				.pill--coral {
					background: var(--coral);
					color: var(--white);
				}

				/* メインのタイトルエリア */
				.hero {
					position: relative;
					z-index: 1;
					background: var(--white);
					border: 3px solid var(--ink);
					border-radius: 20px;
					padding: 26px 20px;
					box-shadow: 5px 5px 0 var(--ink);
					text-align: center;
					margin: 14px 0;
				}

				.kicker {
					display: inline-block;
					background: #e8f8f5;
					color: #0f766e;
					border: 2px solid var(--ink);
					border-radius: 8px;
					padding: 3px 10px;
					font-size: 12px;
					font-weight: 700;
					margin-bottom: 12px;
					transform: rotate(-1.5deg);
				}

				.pop-title {
					font-size: clamp(24px, 5.8vw, 34px);
					font-weight: 900;
					line-height: 1.32;
					letter-spacing: 0.04em;
				}

				.pop-title .highlight {
					background: linear-gradient(transparent 55%, var(--card-yellow) 55%);
					padding: 0 4px;
				}

				.mini-badges {
					margin-top: 16px;
					display: flex;
					justify-content: center;
					gap: 8px;
					flex-wrap: wrap;
					font-size: 11px;
					font-weight: 700;
				}

				.mini-badges span {
					background: var(--bg-pop);
					border: 2px solid var(--ink);
					border-radius: 10px;
					padding: 4px 10px;
				}

				/* 帯（ステッカー風） */
				.sticker-obi {
					position: relative;
					z-index: 2;
					background: var(--coral);
					color: var(--white);
					border: 3px solid var(--ink);
					border-radius: 14px;
					padding: 12px 16px;
					font-size: 13px;
					font-weight: 700;
					line-height: 1.6;
					text-align: center;
					box-shadow: 4px 4px 0 var(--ink);
					transform: rotate(-1.2deg);
				}

				.bottom-meta {
					position: relative;
					z-index: 1;
					display: flex;
					justify-content: space-between;
					align-items: baseline;
					padding-top: 14px;
					border-top: 2px dashed var(--ink);
					font-size: 13px;
					font-weight: 800;
				}

				.author-name {
					font-size: 16px;
					letter-spacing: 0.08em;
				}

				.publisher {
					font-size: 11px;
					opacity: 0.75;
				}
			</style>
		</head>
		<body>
			<article class="pop-book" aria-label="ポップな本の表紙デザイン">
				<div class="corner-star" aria-hidden="true">★</div>

				<header class="top-bar">
					for i, pill := range data.Pills {
						<span class={ "pill", templ.KV("pill--coral", i == 0) }>{ pill }</span>
					}
				</header>

				<section class="hero">
					<p class="kicker">{ data.Kicker }</p>
					<h1 class="pop-title">
						for i, line := range data.Title {
							if i > 0 {
								<br/>
							}if i == 1 {
								<span class="highlight">{ line }</span>
							}else {
								{line}}
						}
					</h1>
					<div class="mini-badges">
						for _, badge := range data.Badges {
							<span>{ badge }</span>
						}
					</div>
				</section>

				<div class="sticker-obi">
					@Lines(data.Obi)
				</div>

				<footer class="bottom-meta">
					<span class="author-name">{ data.Author }</span>
					<span class="publisher">{ data.Publisher }</span>
				</footer>
			</article>
		</body>
	</html>
}
